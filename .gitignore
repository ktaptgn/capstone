# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Frontend tooling caches
node_modules/
dist/
dist-ssr/
build/
.next/
.npm-cache-*/
*.local
npm-debug.log*
yarn-error.log*

# UI app local dependencies and builds
ui/**/node_modules/
ui/**/dist/
ui/**/dist-ssr/
ui/**/public/c5_1/*.json
!ui/**/public/c5_1/.gitkeep

# Generated C5.1 simulation outputs
outputs/c5_1/logs/*
outputs/c5_1/summary/*
outputs/c5_1/work_orders/*
outputs/c5_1/analysis/*
!outputs/c5_1/logs/.gitkeep
!outputs/c5_1/summary/.gitkeep
!outputs/c5_1/work_orders/.gitkeep
!outputs/c5_1/analysis/.gitkeep

# C5.3 / C5.4 — track results (CSV/JSON/PNG) but not run logs
outputs/c5_3/logs/*
outputs/c5_4/logs/*

# Local secrets and machine-specific files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/
