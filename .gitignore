*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Frontend tooling caches
node_modules/
dist/
dist-ssr/
build/
.next/
*.local
npm-debug.log*
yarn-error.log*

# UI app local dependencies and builds
ui/**/node_modules/
ui/**/dist/
ui/**/dist-ssr/
ui/**/public/c5_1/*.json
!ui/**/public/c5_1/.gitkeep

# Local/distribution HTML build artifacts
html_build/*
demo_package/*
!html_build/operator_dashboard.html
!demo_package/operator_dashboard.html

# Generated C5.1 simulation outputs
outputs/c5_1/logs/*
outputs/c5_1/summary/*
outputs/c5_1/work_orders/*
outputs/c5_1/analysis/*
!outputs/c5_1/logs/.gitkeep
!outputs/c5_1/summary/.gitkeep
!outputs/c5_1/work_orders/.gitkeep
!outputs/c5_1/analysis/.gitkeep

# Claude Code working directory
.claude/

